# Google Cloud Vision API
# Option 1: Path to your service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json

# Option 2: Inline JSON key (useful for cloud deployments)
# GOOGLE_CREDENTIALS_JSON='{...}'

# App settings
APP_ENV=development
DEMO_MODE=false          # Set to true to use mock data (no API key needed)
DEMO_FALLBACK=false      # If true, returns mock data when Vision API fails
DAILY_REQUEST_LIMIT=500  # Max real Vision API calls per day (0 = unlimited)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PORT=8000
